{
  "name": "ngx-cookie-service-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "docs:dev": "astro dev --root website --port 4300",
    "docs:build": "ngc -p website/tsconfig.app.json --noEmit && astro build --root website",
    "docs:preview": "astro preview --root website --port 4300",
    "build": "ng build ngx-cookie-service",
    "build:ngx-cookie-service-ssr": "ng build ngx-cookie-service-ssr",
    "test": "ng test ngx-cookie-service --watch=false",
    "test:ngx-cookie-service-ssr": "ng test ngx-cookie-service-ssr",
    "lint": "ng lint ngx-cookie-service",
    "lint:ngx-cookie-service-ssr": "ng lint ngx-cookie-service-ssr",
    "format": "prettier \"./projects/**/*.{ts,json}\" \"./website/**/*.{ts,mjs,json,css,html}\"",
    "format:write": "pnpm format --write",
    "format:check": "pnpm format --check",
    "package": "ng build ngx-cookie-service --configuration=production && cp ./README.md ./dist/ngx-cookie-service && cd dist/ngx-cookie-service && npm pack",
    "build:all": "ng build ngx-cookie-service --configuration=production && ng build ngx-cookie-service-ssr --configuration=production",
    "lint:docs": "eslint website/src"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/platform-server": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@angular/ssr": "^22.2.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@analogjs/astro-angular": "^2.9.7",
    "@analogjs/vite-plugin-angular": "^2.9.7",
    "@angular-eslint/builder": "22.6.0",
    "@angular/animations": "^22.2.6",
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@angular/language-service": "^22.2.6",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/starlight": "^0.43.1",
    "@eslint/js": "^10.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^26.6.5",
    "angular-eslint": "22.6.0",
    "astro": "^7.4.13",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "ng-packagr": "^22.2.4",
    "prettier": "3.9.10",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "^5.0.4"
  },
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/exec",
        {
          "prepareCmd": "bash release.sh ${nextRelease.version}"
        }
      ],
      [
        "@semantic-release/npm",
        {
          "pkgRoot": "dist/ngx-cookie-service"
        }
      ],
      [
        "@semantic-release/npm",
        {
          "pkgRoot": "dist/ngx-cookie-service-ssr"
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "projects/ngx-cookie-service/package.json",
            "projects/ngx-cookie-service-ssr/package.json"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ],
      "@semantic-release/github"
    ]
  }
}
